[0m22:14:51.299680 [debug] [Thread-4 (]: On model.ecommerce_dbt_staging.assert_positive_order_quantities: create or replace   view ECOMMERCE_DB.STAGING.assert_positive_order_quantities
  
  
  
  
  as (
    SELECT
    order_id,
    quantity
FROM ECOMMERCE_DB.STAGING_STAGING.stg_orders
WHERE quantity IS NULL
   OR quantity <= 0
  )
/* {"app": "dbt", "dbt_version": "1.11.11", "profile_name": "ecommerce", "target_name": "dev", "node_id": "model.ecommerce_dbt_staging.assert_positive_order_quantities"} */;
